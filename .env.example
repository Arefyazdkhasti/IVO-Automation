# Server Configuration
PORT=3000
NODE_ENV=development

# Playwright
# سرور/Docker بدون مانیتور: true (پیش‌فرض)
# PLAYWRIGHT_HEADLESS=true
# لوکال مک/ویندوز برای دیدن پنجره مرورگر: false
# PLAYWRIGHT_HEADLESS=false
# Docker headed با نمای مجازی (بدون دیدن روی دسکتاپ شما):
# PLAYWRIGHT_USE_XVFB=true
# PLAYWRIGHT_HEADLESS=false

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-publishable-or-service-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
